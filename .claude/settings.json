{
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -m pytest tests/ -q)",
      "Bash(./.venv/Scripts/python.exe -c \"import opentelemetry\")",
      "Bash(./.venv/Scripts/python.exe -m pip list)",
      "Bash(./.venv/Scripts/python.exe -c ' *)",
      "Bash(./.venv/Scripts/python.exe -m pytest tests/test_otel_export.py -q)",
      "Bash(./.venv/Scripts/python.exe -m pip index versions presidio-analyzer)",
      "Bash(./.venv/Scripts/python.exe -c \"import presidio_analyzer, presidio_anonymizer; print\\('ok'\\)\")",
      "Bash(./.venv/Scripts/python.exe -m spacy download en_core_web_sm)",
      "Bash(./.venv/Scripts/python.exe -m pytest tests/test_redaction.py -q)",
      "Bash(git mv *)",
      "Bash(git checkout *)",
      "Bash(uv lock *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
